# Salin menjadi .env lalu isi. File .env tidak ikut di-commit (.gitignore).
# URL RPC Sepolia dari Infura, contoh: https://sepolia.infura.io/v3/<PROJECT_ID>
SEPOLIA_RPC_URL=
# Kunci API Etherscan untuk verifikasi kode sumber kontrak acuan
ETHERSCAN_API_KEY=
# Akun deploy: simpan sebagai keystore terenkripsi (cast wallet import penerbit --interactive),
# bukan private key di file ini. Isi nama akun keystore di sini.
AKUN_DEPLOY=penerbit
# Alamat publik akun yang sama (bukan rahasia), untuk cek saldo ETH Sepolia di cek_lingkungan.sh
ALAMAT_DEPLOY=
